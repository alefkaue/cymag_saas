# CYMAG Enterprise — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o .env real.

# Chave da API Groq para o AEGIS (IA). Sem ela, o AEGIS roda em modo offline.
# Dica: você NÃO precisa definir aqui — o admin pode colar e testar uma chave
# direto na interface (menu "IA / AEGIS"). Crie uma grátis em console.groq.com/keys.
GROQ_API_KEY=

# Chave secreta do Flask para assinar as sessões (obrigatória em produção).
# Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
CYMAG_SECRET_KEY=

# Caminho do banco SQLite (padrão: instance/cymag.db)
CYMAG_DB_PATH=

# Senha do usuário admin criado no primeiro boot (padrão: gerada e exibida no log)
CYMAG_ADMIN_PASSWORD=

# Host/porta do servidor (padrão 127.0.0.1:5000). Use 0.0.0.0 para expor na rede.
CYMAG_HOST=127.0.0.1
CYMAG_PORT=5000
